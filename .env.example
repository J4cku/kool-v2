# PostHog EU project API key (phc_...). Analytics is a no-op when unset —
# set locally in .env.local and in the Vercel project env vars.
NEXT_PUBLIC_POSTHOG_KEY=

# Resend (contact/brief form delivery). Unset = the form falls back to a
# prefilled mailto. From-address requires the koolstudio.pl domain verified
# in Resend — its DNS records (DKIM selector + send. return-path subdomain)
# are additive and do not touch the OVH mailbox records.
RESEND_API_KEY=
BRIEF_FROM_EMAIL="Kool Studio <hello@koolstudio.pl>"
BRIEF_TO_EMAIL=hello@koolstudio.pl

# Meta Pixel / Conversions API (dataset "KOOL Studio | Website").
# The pixel id is public and hardcoded in lib/site.ts — set this only to point
# a preview build at another dataset, or to "" to disable the pixel entirely.
# Left commented out deliberately: an empty value here is not "unset", it is
# the kill switch, so copying this file verbatim must not silence the pixel.
# NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API token: Events Manager -> Settings -> Conversions API ->
# Generate access token. Unset = the server-side Lead is skipped; the browser
# Pixel still fires for visitors who accepted cookies.
META_CAPI_ACCESS_TOKEN=

# Temporary, for Events Manager -> Test Events. Tags CAPI events so they show
# up in the test stream instead of production reporting. Remove after testing.
META_TEST_EVENT_CODE=
