{
  "name": "kool-v2",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "next dev --port ${CONDUCTOR_PORT:-8080}",
    "build": "next build",
    "start": "next start --port ${PORT:-8080}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "vitest run && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm check:i18n && pnpm build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.43.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "posthog-js": "^1.418.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
